node_modules/
.next/
# Direktori build server dev milik test/ui.test.ts.
#
# `var/` ikut di sini karena Next membuang garis miring depan dari distDir,
# jadi path absolut ke folder sementara mendarat sebagai `var/folders/...` di
# dalam proyek. Test-nya sudah tidak melakukan itu lagi, tapi baris ini yang
# mencegah 554 berkas build ikut ter-commit untuk kedua kalinya.
.next-uji/
var/
data.db
data.db-wal
data.db-shm
test-results/
*.log

# Dibuat ulang oleh `next build`, tidak perlu diversikan
next-env.d.ts
*.tsbuildinfo

# Lokal, tidak diversikan
.claude/
.claude-flow/
# `docs/*`, bukan `docs/`: git tidak bisa membatalkan pengecualian berkas yang
# direktori induknya sudah dikecualikan, jadi pengecualian tutorial di bawah
# tidak akan pernah berlaku kalau direktorinya sendiri yang diabaikan.
docs/*
# Kecuali rekaman tutorial, yang ditunjuk README dan harus ikut ke GitHub.
!docs/tutorial.mp4
ruvector.db
.env

# Tangkapan layar Mobile Parity. Ditulis ulang setiap pemindaian, dan satu
# situs bisa memuat puluhan megabita — artefak runtime, bukan bagian proyek.
weblyzer-tangkapan/

# Blob biner dari tooling lokal, bukan bagian proyek
agentdb.rvf
agentdb.rvf.lock
claude-seo-out/

# demo.db SENGAJA ter-track — ia data demo yang dibundel untuk halaman /demo,
# bukan database kerja. WAL-nya tidak: berkas itu artefak runtime.
demo.db-wal
demo.db-shm
